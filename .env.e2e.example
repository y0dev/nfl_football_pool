# E2E test environment — copy to .env.e2e (gitignored) and fill in.
#
# Used by scripts/set-e2e-secrets.py to set the GitHub Actions secrets the
# nightly E2E workflow (.github/workflows/e2e.yml) needs:
#
#   python scripts/set-e2e-secrets.py --dry-run   # preview
#   python scripts/set-e2e-secrets.py --run       # set secrets, start one run
#
# Point this at a SEPARATE, non-production Supabase project. The suite seeds
# demo admin accounts and creates/deletes "E2E "-prefixed pools and
# e2e-*@sundayhuddle.* commissioners in whatever database it is given.
#
# One-time setup of that project:
#   1. Supabase dashboard → New project (free tier is fine).
#   2. Load the schema without touching your production CLI link:
#        npx supabase db push --db-url "postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"
#   3. Load NFL teams and games into it (temporarily point .env.local at it,
#      run `npm run fetch-nfl-data`, then switch .env.local back).

# --- Required: the test Supabase project (Settings → API) -------------------
# -> E2E_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# -> E2E_SUPABASE_ANON_KEY (anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# -> E2E_SUPABASE_SERVICE_ROLE_KEY (service_role / secret key — server only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: generated randomly by the script when left empty --------------
# Any random string works; CI's app server and tests share whatever is set.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -> E2E_POOL_ACCESS_SECRET (signs private-pool access cookies)
POOL_ACCESS_SECRET=
# -> E2E_SESSION_SECRET (signs admin session cookies)
SESSION_SECRET=
# -> E2E_DEV_MASTER_KEY (dev-only password reset the e2e specs exercise)
DEV_MASTER_KEY=

# Nothing else is needed: the workflow skips the Stripe specs and doesn't send
# email, so no Stripe, SMTP or NFL API keys belong here.
